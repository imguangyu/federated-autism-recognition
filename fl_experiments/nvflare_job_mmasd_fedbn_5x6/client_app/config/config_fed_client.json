{
  "format_version": 2,
  "executors": [
    {
      "tasks": [
        "train"
      ],
      "executor": {
        "path": "nvflare.app_common.executors.in_process_client_api_executor.InProcessClientAPIExecutor",
        "args": {
          "task_script_path": "nvflare_mmasd_client.py",
          "task_script_args": "--theme {SITE_NAME} --device cuda:0 --fl_method fedavg --personalization fedbn --local_epochs 5 --warmup_rounds 5",
          "params_transfer_type": "FULL",
          "params_exchange_format": "NUMPY",
          "server_expected_format": "NUMPY",
          "train_with_evaluation": true
        }
      }
    }
  ],
  "task_data_filters": [],
  "task_result_filters": [],
  "components": [
    {
      "id": "event_to_fed",
      "path": "nvflare.app_common.widgets.convert_to_fed_event.ConvertToFedEvent",
      "args": {
        "events_to_convert": [
          "analytix_log_stats"
        ],
        "fed_event_prefix": "fed."
      }
    }
  ]
}

