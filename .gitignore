data/nturgbd_raw/
data/ntu/**/*.npy
data/ntu120/**/*.npy
data/NW-UCLA/all_sqe/

# Large generated media (keep small PNGs for docs)
data/MMASD+/*.gif
data/MMASD+/skeleton_motion.gif

# Pickles / scores (regenerated at eval)
**/epoch*_score.pkl
**/wrong_*.txt

# Logs
*.log
!fl_experiments/**/*.md

# Secrets / local env
.env
.env.*
*.pem

